# Anthropic API key for looplia
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Development mode - load plugins from source
# Set LOOPLIA_DEV=true to load plugins directly from ./plugins/ instead of ~/.looplia
# LOOPLIA_DEV_ROOT specifies the repo root (defaults to cwd if not set)
LOOPLIA_DEV=true
LOOPLIA_DEV_ROOT=/path/to/looplia-core

# =============================================================================
# Model Provider Configuration (v0.6.6)
# =============================================================================
# Alternative to using `looplia config provider` CLI commands.
# These environment variables override CLI configuration when set.
#
# For ZenMux or other Anthropic-compatible providers:
# ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-ai-v1-your-key-here
#
# Model tier mappings (override default models):
# ANTHROPIC_DEFAULT_HAIKU_MODEL=anthropic/claude-haiku-4.5
# ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.5
# ANTHROPIC_DEFAULT_OPUS_MODEL=anthropic/claude-opus-4.5
#
# See docs/DESIGN-0.6.6.md for full configuration guide.

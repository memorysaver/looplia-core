# =============================================================================
# API Keys (v0.6.6 - Unified Pattern)
# =============================================================================
# Set the key for your provider. Looplia auto-maps based on selected preset.
#
# For Anthropic (direct):
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here
#
# For ZenMux (auto-mapped to ANTHROPIC_AUTH_TOKEN when preset is ZENMUX_*):
# ZENMUX_API_KEY=sk-ai-v1-your-zenmux-key-here

# Development mode - load plugins from source
# Set LOOPLIA_DEV=true to load plugins directly from ./plugins/ instead of ~/.looplia
# LOOPLIA_DEV_ROOT specifies the repo root (defaults to cwd if not set)
LOOPLIA_DEV=true
LOOPLIA_DEV_ROOT=/path/to/looplia-core

# =============================================================================
# Model Provider Configuration (v0.6.6)
# =============================================================================
# Alternative to using `looplia config provider` CLI commands.
# Environment variables override CLI configuration when set.
#
# Agent model configuration (looplia-specific):
# LOOPLIA_AGENT_MODEL_MAIN=z-ai/glm-4.7
# LOOPLIA_AGENT_MODEL_EXECUTOR=z-ai/glm-4.7
#
# Available ZenMux models:
#   z-ai/glm-4.7                  - GLM 4.7
#   minimax/minimax-m2.1          - MiniMax M2.1
#   google/gemini-3-flash-preview - Gemini 3 Flash
#
# See docs/DESIGN-0.6.6.md for full configuration guide.

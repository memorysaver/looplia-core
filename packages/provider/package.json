{
  "name": "@looplia-core/provider",
  "version": "0.8.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/claude-agent-sdk/index.d.ts",
      "import": "./dist/claude-agent-sdk/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "import": "./dist/bootstrap/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./utils/fs": {
      "types": "./dist/utils/fs.d.ts",
      "import": "./dist/utils/fs.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.75",
    "@looplia-core/core": "workspace:*",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@looplia-core/config": "workspace:*",
    "@types/bun": "^1.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
